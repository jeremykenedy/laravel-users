{
    "name": "jeremykenedy/laravel-users",
    "description": "Laravel Users Management CRUD Package",
    "keywords": [
        "laravel",
        "users",
        "management",
        "CRUD"
    ],
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "jeremykenedy",
            "email": "jeremykenedy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\laravelusers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\laravelusers\\Test\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\laravelusers\\LaravelUsersServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "suggest": {
        "jeremykenedy/laravel-ui-kit": "Optional host application integration. See docs/integrations.md.",
        "jeremykenedy/laravel-toast": "Optional host application integration. See docs/integrations.md.",
        "jeremykenedy/laravel-darkmode-toggle": "Optional host application integration. See docs/integrations.md.",
        "jeremykenedy/laravel-ip-capture": "Optional host application integration. See docs/integrations.md.",
        "jeremykenedy/laravel-seedster": "Optional host application integration. See docs/integrations.md."
    }
}
