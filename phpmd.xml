<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Laravel Users">
    <description>Analyze package PHP while allowing Laravel facades and stateless helpers.</description>
    <exclude-pattern>*/resources/views/*</exclude-pattern>
    <exclude-pattern>*/tests/Fixtures/views/*</exclude-pattern>
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <properties>
            <property name="exceptions" value="
                Composer\InstalledVersions,DiceBear\Style,
                Illuminate\Support\Arr,Illuminate\Support\Carbon,Illuminate\Support\Str,Illuminate\Support\ServiceProvider,
                Illuminate\Database\Eloquent\Model,Illuminate\Http\Request,
                Illuminate\Support\Facades\Blade,Illuminate\Support\Facades\Bus,Illuminate\Support\Facades\DB,
                Illuminate\Support\Facades\Event,Illuminate\Support\Facades\Http,Illuminate\Support\Facades\Mail,
                Illuminate\Support\Facades\Notification,Illuminate\Support\Facades\Password,
                Illuminate\Support\Facades\Queue,Illuminate\Support\Facades\RateLimiter,Illuminate\Support\Facades\Schema,
                Illuminate\Support\Facades\Auth,Illuminate\Support\Facades\Cache,
                Illuminate\Support\Facades\File,Illuminate\Support\Facades\Gate,
                Illuminate\Support\Facades\Hash,Illuminate\Support\Facades\Log,
                Illuminate\Support\Facades\Route,Illuminate\Support\Facades\Validator,
                Illuminate\Support\Facades\View,Illuminate\Validation\Rule,
                Illuminate\Validation\ValidationException,
                Jeremykenedy\LaravelToast\Facades\Toast,Jeremykenedy\LaravelToast\Support\ToastAnimations,
                Spatie\Permission\Guard,Spatie\Permission\Models\Permission,Spatie\Permission\Models\Role,
                Laravel\Prompts\Prompt,Dotenv\Dotenv,
                jeremykenedy\LaravelRoles\Models\Permission,jeremykenedy\LaravelRoles\Models\Role,
                jeremykenedy\laravelusers\Models\AccountLink,jeremykenedy\laravelusers\Models\EmailChange,
                jeremykenedy\laravelusers\Models\UserSetting,
                jeremykenedy\laravelusers\Console\ConsolePrompts,
                jeremykenedy\laravelusers\Support\AccountPreferences,
                jeremykenedy\laravelusers\Support\AppearancePreferences,
                jeremykenedy\laravelusers\Support\AvatarPreferences,
                jeremykenedy\laravelusers\Support\DeletedUserRetention,
                jeremykenedy\laravelusers\Support\EmailContent,
                jeremykenedy\laravelusers\Support\Frontend,
                jeremykenedy\laravelusers\Support\GoodbyeEmail,
                jeremykenedy\laravelusers\Support\LocalAvatars,
                jeremykenedy\laravelusers\Support\ManagedPackages,
                jeremykenedy\laravelusers\Support\MiddlewareAccess,
                jeremykenedy\laravelusers\Support\NativeRuntime,
                jeremykenedy\laravelusers\Support\PackageOperations,
                jeremykenedy\laravelusers\Support\PackageRequirements,
                jeremykenedy\laravelusers\Support\PackageWorker,
                jeremykenedy\laravelusers\Support\PasswordRules,
                jeremykenedy\laravelusers\Support\PublicAssets,
                jeremykenedy\laravelusers\Support\RoleAccess,
                jeremykenedy\laravelusers\Support\ToastSettings,
                jeremykenedy\laravelusers\Support\ToastSetup,
                jeremykenedy\laravelusers\Support\UserAccess,
                jeremykenedy\laravelusers\Support\UserNotifications,
                jeremykenedy\laravelusers\Support\UserPermissions,
                jeremykenedy\laravelusers\Support\UserRoles"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
